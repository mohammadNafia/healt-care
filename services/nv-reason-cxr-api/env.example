# Hugging Face Model Configuration
HF_MODEL_NAME=nvidia/NV-Reason-CXR-3B
HF_TOKEN=your_huggingface_token_here_if_needed

# Device Configuration
DEVICE=cuda
# If CUDA is not available, will fallback to CPU automatically

# Generation Configuration
MAX_NEW_TOKENS=1024

# Server Configuration
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Optional: Use Hugging Face Space instead of local model
USE_HF_SPACE=false
HF_SPACE_URL=https://huggingface.co/spaces/nvidia/nv-reason-cxr
